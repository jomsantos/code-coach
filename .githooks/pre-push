#!/bin/sh
set -eu

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required to run the pre-push checks. Install mise, then run 'mise run verify'." >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "Running Code Coach checks and all unit and browser tests before push..."
mise run pre-push
